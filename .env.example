DIVALTO_BASE_URL=https://your-divalto-server.com
DIVALTO_AUTH_URL=https://your-divalto-server.com/auth
DIVALTO_WS_URL=https://your-divalto-server.com/webservice
DIVALTO_USER=Infolib
DIVALTO_PASSWORD=LibInfo
DIVALTO_ENV=ERP221
DIVALTO_DOSSIER_CODE=998

# Use local SQLite backend instead of real endpoints (dev/testing)
DIVALTO_USE_SQLITE_MOCK=true
DIVALTO_SQLITE_DB_PATH=warehouse/magasin_mock.db

# Semantic analytics / MDX (Phase 4 data questions) — optional; auto-builds from SQLite when missing
# DIVALTO_SEMANTIC_MODEL_DIR=d:/PFE_final/agent_project/generated_olap
# DIVALTO_OLAP_CUBE_NAME=AutoCube
# DIVALTO_AUTO_GENERATE_SEMANTIC_FROM_SQLITE=true
# DIVALTO_OLLAMA_ANALYTIC_NUM_PREDICT=2048
# DIVALTO_OLLAMA_ANALYTIC_TIMEOUT_SECONDS=120

# Append catalog-driven SQL+MDX analytics to classic Phase 3 answers (needs Ollama + semantic_model.json)
# DIVALTO_SEMANTIC_ANALYTICS_IN_CLASSIC=true
# DIVALTO_SEMANTIC_ANALYTICS_MIN_QUERY_LEN=10

# Remote MDX execution (pyadomd + Microsoft ADOMD.NET). Off by default.
# DIVALTO_MDX_EXECUTE_ENABLED=false
# DIVALTO_MDX_CONNECTION_STRING=Provider=MSOLAP;Data Source=localhost;Initial Catalog=YourModel;
# DIVALTO_MDX_MAX_ROWS=500
# DIVALTO_MDX_TIMEOUT_SECONDS=120
DIVALTO_AUTH_TIMEOUT_SECONDS=10
DIVALTO_WS_TIMEOUT_SECONDS=15
DIVALTO_HTTP_MAX_RETRIES=3
DIVALTO_AUTH_TOKEN_TTL_SECONDS=3600

# Ollama — speed tuning (optional)
# Smaller / quant models load faster: e.g. llama3.2:3b-instruct-q4_K_M, phi3:mini
# DIVALTO_OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
# DIVALTO_OLLAMA_TIMEOUT_SECONDS=45
# DIVALTO_OLLAMA_RETRIES=1
# DIVALTO_OLLAMA_NUM_PREDICT=512
# Max seconds for Phase 3/5 JSON planner (Ollama); then rule-based mock plan is used (default 25)
# DIVALTO_LLM_PLAN_TIMEOUT_SECONDS=25
# DIVALTO_OLLAMA_NUM_CTX=4096
# DIVALTO_OLLAMA_KEEP_ALIVE=15m
# Fewer RAG chunks = shorter prompts = faster planner
# DIVALTO_RAG_ENABLED=false
# DIVALTO_RAG_TOP_K=2

# Chat feedback JSONL (thumbs up/down from UI); default datasets/chat_answer_feedback.jsonl
# DIVALTO_FEEDBACK_JSONL_PATH=d:/PFE_final/agent_project/datasets/chat_answer_feedback.jsonl

# Frontend chat abort (ms) when using real planner — raise if Ollama is slow on CPU
# VITE_CHAT_TIMEOUT_REAL_MS=150000
# Mock planner default is 90s (classic/phase5 do not call Ollama; still allow slow ERP/SQLite)
# VITE_CHAT_TIMEOUT_MOCK_MS=90000
